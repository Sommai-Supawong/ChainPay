NEXT_PUBLIC_APP_URL=https://chain-pay-eta.vercel.app/

# Browser-safe Firebase web app settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase service account, server only
FIREBASE_PROJECT_ID=chainpay-5588d
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Neon pooled URL for requests; direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Sepolia only. Never use a secret RPC URL in a public variable.
# Chain ID is fixed at 11155111 in src/lib/blockchain/config.ts.
NEXT_PUBLIC_CHAINPAY_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAINPAY_CONTRACT_VERSION=2
# Deployed V1 address for historical verification and pre-upgrade payment recovery; server only.
CHAINPAY_V1_CONTRACT_ADDRESS=
ETHEREUM_RPC_URL=
