# Local: http://localhost:3000
# Production: https://chain-pay-eta.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser-safe Firebase web app settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase service account, server only
FIREBASE_PROJECT_ID=chainpay-5588d
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Neon pooled URL for requests; direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Sepolia only. Never use a secret RPC URL in a NEXT_PUBLIC_* variable.
# Chain ID is fixed at 11155111 in src/lib/blockchain/config.ts.
NEXT_PUBLIC_CHAINPAY_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAINPAY_CONTRACT_VERSION=2
NEXT_PUBLIC_CHAINPAY_ESCROW_CONTRACT_ADDRESS=
# Deployed V1 address for historical verification and pre-upgrade payment recovery; server only.
CHAINPAY_V1_CONTRACT_ADDRESS=
# Server-only Ethereum Sepolia RPC (eth_chainId must return 11155111).
# Never use an Ethereum Mainnet endpoint such as https://eth-mainnet.g.alchemy.com/...
ETHEREUM_RPC_URL=
